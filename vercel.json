{
  "version": 2,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.3"
    },
    "api/setup.php": {
      "runtime": "vercel-php@0.7.3"
    }
  },
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "public/assets/$1"
    },
    {
      "src": "/setup",
      "dest": "api/setup.php"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.php?route=$1"
    }
  ],
  "env": {
    "APP_ENV": "production",
    "APP_DEBUG": "0"
  }
}